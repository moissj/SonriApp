# Variables de entorno para el build de producción (Vercel / Netlify).
# NO subas el archivo .env real al repositorio; define estas variables en el
# panel del proveedor. La anon key es PÚBLICA por diseño (RLS protege los datos).
# La SERVICE_ROLE_KEY NUNCA va aquí ni en el frontend: solo vive en las
# Edge Functions de Supabase.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica
