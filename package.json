{
  "name": "sonri-app-v2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "config:prod": "node scripts/set-env.js",
    "build:prod": "node scripts/set-env.js && ng build",
    "watch": "ng build --watch --configuration development",
